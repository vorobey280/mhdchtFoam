FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;

    transport       polynomial;
    thermo          hPolynomial;
    equationOfState icoPolynomial;
    specie          specie;

    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight   0.040;
    }
    equationOfState
    {
        rhoCoeffs<8>        (1178.89 0.21822 -0.0014404 0 0 0 0 0);
    }
    thermodynamics
    {
        CpCoeffs<8>  (3225.576 2.086 -0.000952 0 0 0 0 0);
        Hf          0;
				Sf					0;
    }
    transport
    {
        muCoeffs<8>          (0.003138 2.248e-6 1.105e-9 0 0 0 0 0);
        kappaCoeffs<8>          (0.6427 0 0 0 0 0 0 0);
    }
}

